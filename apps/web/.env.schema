# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false @sensitive=false
VERCEL_ENV=

# @internal @required=false @sensitive=false
VERCEL_URL=

# @internal @required=false @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @sensitive=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# Accounts (sign-up, sign-in, saved orders) switch on only when this and DATABASE_URL are both set.
# Leave both empty to run as a prototype: the menu, bag and checkout still work.
# @type=string(minLength=32) @required=false
BETTER_AUTH_SECRET=

# @type=url @sensitive=false
BETTER_AUTH_URL=$VERCEL_ORIGIN

# MongoDB connection string, e.g. a MongoDB Atlas mongodb+srv://… URI with the database name in the path.
# @type=string(minLength=1) @required=false
DATABASE_URL=

# Paystack secret key (sk_test_... or sk_live_...). Used server-side only to start and verify payments.
# @required=false
PAYSTACK_SECRET_KEY=

# SmartSale (the shops' POS) supplies the branches, the menu, prices, stock and delivery settings.
# The organisation's Firebase database URL and its UUID. Anyone holding both can read the shop's
# data (and possibly queue sales), so keep them out of git: set them in apps/web/.env locally and
# in Vercel's environment variables.
# @type=url
SMARTSALE_BASE_URL=

# @type=string(minLength=1)
SMARTSALE_ORG_UUID=

# When true, each paid order is sent to its branch's POS as a sale (it prints a slip at the till).
# Keep it false while testing, or test orders will show up in the shop as real sales.
# @type=boolean @required=false @sensitive=false
SMARTSALE_SUBMIT_ORDERS=false
