# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local, auto=false)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @internal @required=false @sensitive=false
VERCEL_ENV=

# @internal @required=false @sensitive=false
VERCEL_URL=

# @internal @required=false @sensitive=false
VERCEL_PROJECT_PRODUCTION_URL=

# @internal @required=false @sensitive=false @type=url(prependHttps=true)
VERCEL_ORIGIN=if(eq($VERCEL_ENV, production), fallback($VERCEL_PROJECT_PRODUCTION_URL, $VERCEL_URL), fallback($VERCEL_URL, $VERCEL_PROJECT_PRODUCTION_URL))

# Accounts (sign-up, sign-in, saved orders) switch on only when this and DATABASE_URL are both set.
# Leave both empty to run as a prototype: the menu, bag and checkout still work.
# @type=string(minLength=32) @required=false
BETTER_AUTH_SECRET=

# @type=url @sensitive=false
BETTER_AUTH_URL=$VERCEL_ORIGIN

# MongoDB connection string, e.g. a MongoDB Atlas mongodb+srv://… URI with the database name in the path.
# @type=string(minLength=1) @required=false
DATABASE_URL=

# Paystack secret key (sk_test_... or sk_live_...). Used server-side only to start and verify payments.
# @required=false
PAYSTACK_SECRET_KEY=
